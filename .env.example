APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# When running API server: use http://localhost:8000

# Frontend URL for CORS, Sanctum, and password reset links
FRONTEND_URL=http://localhost:3000

# Next.js on-demand revalidation (when Admin updates content)
NEXTJS_SITE_URL=http://localhost:3000
NEXTJS_REVALIDATION_SECRET=your-secret-key

# Sanctum: domains that receive stateful auth cookies (comma-separated)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Firebase (optional) - real-time "new order" notifications for the dashboard.
#
# Service-account credentials MUST NOT be committed. Supply them in ONE of two
# ways; if neither is set, FirebaseNotificationService::isConfigured() returns
# false and OrderObserver silently skips notification (no error).
#
#   1. FIREBASE_CREDENTIALS      - filesystem path to the service-account JSON.
#                                  Relative paths resolve from the project root.
#                                  Keep the file OUTSIDE the repo, or in
#                                  storage/app/ (gitignored) on the server only.
#   2. FIREBASE_CREDENTIALS_JSON - the raw JSON as a single-line string. Prefer
#                                  this on PaaS hosts with no persistent disk.
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# Password given to seeded admin users (AdminUserSeeder)
SEED_ADMIN_PASSWORD=
